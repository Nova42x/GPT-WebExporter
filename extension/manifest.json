{
  "manifest_version": 3,
  "name": "ChatGPT 原版交互离线导出",
  "version": "0.1.3",
  "description": "将当前 ChatGPT 对话保存为保留原版样式和 Intelligent UI 交互的单文件 HTML。",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://chatgpt.com/*", "https://*.oaistatic.com/*", "https://*.oaiusercontent.com/*", "https://cdn.platform.openai.com/*", "https://cdn.openai.com/*", "https://www.google.com/*", "https://at.alicdn.com/*"],
  "action": {"default_title": "导出当前 ChatGPT 对话"},
  "background": {"service_worker": "background.js", "type": "module"}
}
